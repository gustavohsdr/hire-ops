generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Cargo {
  id                 String   @id @default(uuid())
  nome               String   @unique
  categoria          String   @default("ADMINISTRATIVO")
  departamento       String?
  centroDeCusto      String?
  slaPadrao          Int      @default(30)
  cargaHoraria       String?
  salarioEstagio     Float?
  salarioJunior      Float?
  salarioPleno       Float?
  salarioSenior      Float?
  salarioCoordenador Float?
  createdAt          DateTime @default(now())
  vagas              Vaga[]
}

model Unidade {
  id        String   @id @default(uuid())
  nome      String   @unique
  createdAt DateTime @default(now())
}

model Gestor {
  id        String   @id @default(uuid())
  nome      String   @unique
  createdAt DateTime @default(now())
}

model Vaga {
  id              Int         @id @default(autoincrement())
  cargoId         String
  cargo           Cargo       @relation(fields: [cargoId], references: [id])
  nivel           String
  quantidade      Int         @default(1)
  unidade         String
  departamento    String
  gestor          String
  recrutador      String
  motivo          String
  tipoContrato    String
  cargaHoraria    String?
  salario         Float?
  centroDeCusto   String?
  status          String      @default("Em Aberto")
  subEtapa        String?
  statusAdmissao  String?
  candidatoNome   String?
  dataAdmissao    DateTime?
  slaDias         Int         @default(30)
  dataAbertura    DateTime    @default(now())
  dataFinalizacao DateTime?
  candidatos      Candidato[]
  historicosAdmissao HistoricoAdmissao[]
}

model Candidato {
  id        String   @id @default(uuid())
  vagaId    Int
  vaga      Vaga     @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  nome      String
  email     String
  telefone  String?
  etapa     String   @default("Triagem")
  status    String   @default("Ativo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HistoricoAdmissao {
  id            String   @id @default(uuid())
  vagaId        Int
  vaga          Vaga     @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  candidatoNome String
  resultado     String
  motivo        String?
  dataDecisao   DateTime @default(now())
}
